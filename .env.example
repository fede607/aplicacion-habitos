# ---------------------------------------------------------------
# Winter Arc — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ---------------------------------------------------------------

# URL del proyecto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA (publishable / anon). Está pensada para el navegador:
# la seguridad real la imponen las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (Alternativa para proyectos con claves legacy)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública de la app (se usa en enlaces de invitación y emails).
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# ⚠️ La app NO necesita la SUPABASE_SERVICE_ROLE_KEY. No la añadas a Vercel.
