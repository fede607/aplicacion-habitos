# ---------------------------------------------------------------
# Winter Arc — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ---------------------------------------------------------------

# --- Públicas (van al navegador; son seguras por diseño) ---
# URL del proyecto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PÚBLICA (publishable / anon). La seguridad real la imponen las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (Alternativa para proyectos con claves legacy)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL pública de la app (enlaces de invitación y de los emails).
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
# CAPTCHA Cloudflare Turnstile (clave de SITIO, pública). La clave SECRETA va en
# Supabase → Authentication → Attack Protection, no aquí.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# --- SECRETAS: sólo servidor. NUNCA con prefijo NEXT_PUBLIC_ ---
# Necesaria SÓLO para las notificaciones por email (cron) y verificar emails.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto largo y aleatorio que protege /api/cron/notifications.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=

# SMTP para las notificaciones (usa el mismo en Supabase → Auth → SMTP).
# Gmail: smtp.gmail.com, 465, tu cuenta y una "contraseña de aplicación".
# Resend: smtp.resend.com, 465, usuario "resend", contraseña = API key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=
EMAIL_FROM="Winter Arc <tucuenta@gmail.com>"
